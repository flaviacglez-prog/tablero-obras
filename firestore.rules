rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ACCESO CON CODIGO: solo entra quien escribió el código vigente.
    // El código vive en el documento seguridad/acceso (campo "codigo", texto). Nadie puede leerlo desde la página:
    // las reglas lo consultan por su cuenta. Cambiar ese campo corta el acceso de todos hasta que ingresen el nuevo.
    function signedIn() { return request.auth != null; }
    function codigoVigente() { return get(/databases/$(database)/documents/seguridad/acceso).data.codigo; }
    function esMiembro() {
      return signedIn()
        && exists(/databases/$(database)/documents/miembros/$(request.auth.uid))
        && get(/databases/$(database)/documents/miembros/$(request.auth.uid)).data.codigo == codigoVigente();
    }

    match /seguridad/{id} {
      allow read, write: if false;
    }

    // Cada visitante (por su login anónimo) deja anotado el código que escribió; solo se acepta si es el correcto.
    match /miembros/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['codigo'])
        && request.resource.data.codigo is string
        && request.resource.data.codigo == codigoVigente();
      allow delete: if false;
    }

    match /asignaciones/{id} {
      allow read: if esMiembro();
      allow write: if esMiembro() && request.resource.size() < 20000;
    }
    match /obras/{id} {
      allow read: if esMiembro();
      allow create: if esMiembro()
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() <= 200;
      allow update, delete: if false;
    }
    // Mejoras de la página (panel lateral): cada mejora trae sus fotos (achicadas) y comentarios dentro del documento.
    match /mejoras/{id} {
      allow read: if esMiembro();
      allow create, update: if esMiembro()
        && request.resource.size() < 900000
        && request.resource.data.t is string
        && request.resource.data.t.size() <= 500;
      allow delete: if esMiembro();
    }
    match /comentarios/{id} {
      allow read: if esMiembro();
      allow create: if esMiembro()
        && request.resource.data.autor == request.auth.uid
        && request.resource.data.texto is string
        && request.resource.data.texto.size() <= 2000;
      allow delete: if esMiembro() && resource.data.autor == request.auth.uid;
      allow update: if false;
    }
  }
}