rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cualquier visitante (login anónimo) puede leer y escribir, pero con límites de tamaño.
    function signedIn() { return request.auth != null; }

    match /asignaciones/{id} {
      allow read: if signedIn();
      allow write: if signedIn() && request.resource.size() < 20000;
    }
    match /obras/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() <= 200;
      allow update, delete: if false;
    }
    match /comentarios/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.autor == request.auth.uid
        && request.resource.data.texto is string
        && request.resource.data.texto.size() <= 2000;
      allow delete: if signedIn() && resource.data.autor == request.auth.uid;
      allow update: if false;
    }
  }
}
